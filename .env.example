# Copy to .env for local development. Leave blank until configured securely.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Optional locally; required for a private production deployment.
APP_ACCESS_TOKEN=
# Exact origins, comma-separated, only for a separate frontend such as GitHub Pages.
ALLOWED_ORIGIN=
APP_ENV=development
